<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Group invite · Square</title>
    <style>
      :root { color-scheme: light dark; }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
        background: #f5f5f5;
        color: #111111;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      }
      @media (prefers-color-scheme: dark) {
        body { background: #0a0a0a; color: #f5f5f5; }
        .card { background: #141414 !important; border-color: #262626 !important; }
        .muted { color: #a0a0a0 !important; }
        input {
          background: #0a0a0a !important;
          border-color: #383838 !important;
          color: #f5f5f5 !important;
        }
      }
      .card {
        width: 100%;
        max-width: 380px;
        background: #ffffff;
        border: 1px solid #e4e4e4;
        border-radius: 16px;
        padding: 32px 28px;
      }
      .mark {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        background: #111111;
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 18px;
        margin-bottom: 20px;
      }
      @media (prefers-color-scheme: dark) { .mark { background: #f5f5f5; color: #0a0a0a; } }
      h1 { font-size: 19px; font-weight: 700; margin: 0 0 8px; }
      p { font-size: 14.5px; line-height: 1.55; margin: 0 0 4px; }
      .muted { color: #6e6e6e; }
      .error {
        margin-top: 14px;
        padding: 10px 12px;
        border-radius: 8px;
        background: #fbebeb;
        color: #a4392f;
        font-size: 13.5px;
      }
      @media (prefers-color-scheme: dark) { .error { background: #2e1717; color: #d97b6c; } }
      form { margin-top: 20px; }
      label {
        display: block;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.02em;
        text-transform: uppercase;
        color: #6e6e6e;
        margin-bottom: 6px;
      }
      input {
        width: 100%;
        padding: 12px 14px;
        border-radius: 10px;
        border: 1px solid #e4e4e4;
        font-size: 15px;
        color: inherit;
        background: #fafafa;
      }
      input:focus { outline: none; border-color: #111111; }
      @media (prefers-color-scheme: dark) { input:focus { border-color: #f5f5f5; } }
      button {
        width: 100%;
        margin-top: 16px;
        padding: 13px 16px;
        border: none;
        border-radius: 10px;
        background: #111111;
        color: #ffffff;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
      }
      @media (prefers-color-scheme: dark) { button { background: #f5f5f5; color: #0a0a0a; } }
      button:active { opacity: 0.85; }
      .badge {
        display: inline-block;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.03em;
        text-transform: uppercase;
        padding: 3px 8px;
        border-radius: 6px;
        margin-bottom: 14px;
      }
      .badge.good { background: #e7f5ee; color: #1e8e5a; }
      .badge.bad { background: #fbebeb; color: #a4392f; }
      @media (prefers-color-scheme: dark) {
        .badge.good { background: #12291f; color: #6cb595; }
        .badge.bad { background: #2e1717; color: #d97b6c; }
      }
    </style>
  </head>
  <body>
    <div class="card">
      <div class="mark">S</div>
      <%= yield %>
    </div>
  </body>
</html>
